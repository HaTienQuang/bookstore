{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.0",
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/fonts/(.*)",
      "dest": "/public/fonts/$1"
    },
    {
      "src": "/img/(.*)",
      "dest": "/public/img/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/libs/(.*)",
      "dest": "/public/libs/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/img/favicon.jpg"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
